<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
	<EnableDefaultItems>false</EnableDefaultItems>
    <OutputType>WinExe</OutputType>
    <RootNamespace>VMCreate</RootNamespace>
    <AssemblyName>VMCreate</AssemblyName>
    <WarningLevel>4</WarningLevel>
	<PublishSingleFile>true</PublishSingleFile>
	<SelfContained>true</SelfContained>
	<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
	<EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="App.xaml.cs" />
    <Compile Include="AssemblyInfo.cs" />
    <Compile Include="Gallery\ImageSourceConverter.cs" />
    <Compile Include="Gallery\DateStringConverter.cs" />
    <Compile Include="GUI\MainWindow.xaml.cs" />
    <Compile Include="GUI\ProgressWindow.xaml.cs">
      <DependentUpon>ProgressWindow.xaml</DependentUpon>
  	  <SubType>Code</SubType>
    </Compile>
    <Compile Include="GUI\SelectImagePage.xaml.cs">
    <DependentUpon>SelectImagePage.xaml</DependentUpon>
  	  <SubType>Code</SubType>
    </Compile>
    <Compile Include="GUI\SuccessWindow.xaml.cs" />

    <Compile Include="GUI\VmSettingsPage.xaml.cs">
      <DependentUpon>VmSettingsPage.xaml</DependentUpon>
  	  <SubType>Code</SubType>
    </Compile>
	<Compile Include="GUI\VmCustomizationPage.xaml.cs">
		<DependentUpon>VmCustomizationPage.xaml</DependentUpon>
		<SubType>Code</SubType>
	</Compile>
    <Compile Include="GUI\WizardData.cs" />
    <Compile Include="GUI\WizardFlow.cs" />
    <Compile Include="GUI\ViewModels\ViewModelBase.cs" />
    <Compile Include="GUI\ViewModels\RelayCommand.cs" />
    <Compile Include="GUI\ViewModels\SelectImagePageViewModel.cs" />
    <Compile Include="GUI\ViewModels\VmSettingsPageViewModel.cs" />
    <Compile Include="GUI\ViewModels\VmCustomizationPageViewModel.cs" />
    <Compile Include="GUI\ViewModels\DistributionOptionItem.cs" />
    <Compile Include="GUI\ViewModels\DeploymentPhase.cs" />
    <Compile Include="GUI\ViewModels\DeployPageViewModel.cs" />
    <Compile Include="GUI\ViewModels\DeployPageConverters.cs" />
    <Compile Include="GUI\DeployPage.xaml.cs">
      <DependentUpon>DeployPage.xaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="GUI\IDispatcher.cs" />
    <Compile Include="GUI\WpfDispatcher.cs" />
    <Compile Include="GUI\IDeploymentProgressViewModel.cs" />
    <Compile Include="GUI\DeploymentProgressViewModelAdapter.cs" />
    <Compile Include="GUI\DeploymentProgressPresenter.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="app.manifest" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VMCreate.Core\VMCreate.Core.csproj" />
    <ProjectReference Include="..\VMCreate.Gallery.Contracts\VMCreate.Gallery.Contracts.csproj" />
    <ProjectReference Include="..\VMCreate.Gallery.Security\VMCreate.Gallery.Security.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SharpVectors" Version="1.8.5" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
	  <ApplicationDefinition Include="App.xaml">
		  <Generator>MSBuild:Compile</Generator>
		  <SubType>Designer</SubType>
	  </ApplicationDefinition>
    <Page Include="GUI\MainWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="GUI\ProgressWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="GUI\SelectImagePage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="GUI\SuccessWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="GUI\VmCustomizationPage.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="GUI\VmSettingsPage.xaml">
      <Generator>MSBuild:Compile</Generator>
	  <SubType>Designer</SubType>
	</Page>
    <Page Include="GUI\DeployPage.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

</Project>
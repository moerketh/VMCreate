<Page x:Class="VMCreate.VmCustomizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:VMCreate"
      Title="Configure Virtual Machine">
    <Grid Margin="20,10,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Selected image summary card: pinned above scrollable content -->
        <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="8" Padding="16,12" Margin="0,0,0,12"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding SelectedItem.SymbolUri, Converter={StaticResource ImageConverter}}" 
                       Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedItem.Name, FallbackValue='No VM selected'}" 
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="{Binding SelectedItem.Publisher}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,0,4">
            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource WizardScrollBarStyle}"/>
            </ScrollViewer.Resources>
        <StackPanel Margin="0,0,18,0" FocusManager.FocusedElement="{Binding ElementName=XrdpCheckbox}">

            <ui:InfoBar Title="Conversion required" Severity="Warning"
                        Message="The selected VM is not in VHDX format. It will be converted to VHDX using QEMU. If the disk is MBR partitioned it will be cloned to a new GPT partitioned disk using a converter DVD on first VM boot."
                        IsOpen="{Binding IsNotVhdx, Mode=OneWay}" IsClosable="False" Margin="0,0,0,8"/>

            <ui:InfoBar Title="Administrator approval required" Severity="Informational"
                        Message="This Windows image needs to be modified before first boot (to create the user account and enable remote access). You will be prompted for administrator approval at deployment time."
                        IsOpen="{Binding NeedsUnattendInjection, Mode=OneWay}" IsClosable="False" Margin="0,0,0,8"/>

            <!-- Integration Services card -->
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20,16" Margin="0,0,0,12"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Integration Services" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Hyper-V integration services enable clipboard sharing, drive redirection, and automatic IP discovery via Enhanced Session Mode."
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"
                               TextWrapping="Wrap"/>
                    <CheckBox Content="Enable Hyper-V integration services"
                              IsChecked="{Binding EnableIntegrationServices}"
                              FontSize="14"
                              ToolTip="Controls Guest Service Interface and Enhanced Session Mode (RDP over VMBus)."
                              AutomationProperties.Name="Enable Hyper-V integration services"/>
                </StackPanel>
            </Border>

            <!-- Remote Access card (Linux only) -->
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20,16" Margin="0,0,0,12"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="{Binding ShowLinuxOptions, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Remote Access" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Configure remote desktop access for the virtual machine."
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"/>
                    <RadioButton x:Name="XrdpCheckbox"
                                 Content="xrdp — Hyper-V Enhanced Session (disables Wayland, forces X11)"
                                 GroupName="RdpBackend" FontSize="14"
                                 IsChecked="{Binding IsRdpBackendXrdp}"
                                 ToolTip="Installs and configures xrdp so Enhanced Session mode works with this Linux VM. A helper DVD will boot once to install xrdp, then the VM restarts normally. Disables Wayland and forces X11 for maximum compatibility."
                                 AutomationProperties.Name="Configure xrdp for enhanced session"/>
                    <RadioButton Content="Lamco RDP Server — Wayland-native (preserves Wayland)"
                                 GroupName="RdpBackend" FontSize="14" Margin="0,4,0,0"
                                 IsChecked="{Binding IsRdpBackendLamco}"
                                 Visibility="{Binding LamcoOptionVisible, Converter={StaticResource BoolToVis}}"
                                 ToolTip="Installs Lamco RDP Server, a Wayland-native RDP server built on IronRDP with XDG Desktop Portal + PipeWire. Keeps Wayland enabled. Installs post-boot over SSH (no helper DVD). After first boot, log in at the console once and run 'lamco-rdp-server --grant-permission' to authorize screen sharing (one-time, interactive)."
                                 AutomationProperties.Name="Configure Lamco RDP Server"/>
                    <ui:InfoBar Title="Lamco: one-time permission grant required" Severity="Informational"
                                Message="After the VM first boots, log in at the Hyper-V console once and run 'lamco-rdp-server --grant-permission', then click Allow to authorize screen sharing. This is an interactive Portal dialog that cannot be run over SSH. The server auto-starts on subsequent boots via graphical autologin."
                                IsOpen="{Binding IsRdpBackendLamco, Mode=OneWay}" IsClosable="False" Margin="0,8,0,0"
                                Visibility="{Binding LamcoOptionVisible, Converter={StaticResource BoolToVis}}"/>
                    <RadioButton Content="None — no remote desktop (console/SSH only)"
                                 GroupName="RdpBackend" FontSize="14" Margin="0,4,0,0"
                                 IsChecked="{Binding IsRdpBackendNone}"
                                 ToolTip="No RDP server is installed. Access the VM via the Hyper-V console or SSH only."
                                 AutomationProperties.Name="No remote desktop"/>
                </StackPanel>
            </Border>

            <!-- DNS Configuration card (Linux only) -->
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20,16" Margin="0,0,0,12"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="{Binding ShowLinuxOptions, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="DNS Configuration" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Choose which DNS nameservers the guest VM will use during provisioning. By default, the host machine's DNS servers are forwarded to the guest."
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"
                               TextWrapping="Wrap"/>
                    <RadioButton Content="Use host DNS servers"
                                 IsChecked="{Binding IsHostDns}"
                                 GroupName="DnsMode" FontSize="14"
                                 ToolTip="Forwards this machine's DNS servers to the guest VM."
                                 AutomationProperties.Name="Use host DNS servers"/>
                    <RadioButton Content="Custom nameservers"
                                 IsChecked="{Binding IsCustomDns}"
                                 GroupName="DnsMode" FontSize="14" Margin="0,4,0,0"
                                 ToolTip="Specify custom DNS nameservers for the guest VM."
                                 AutomationProperties.Name="Custom nameservers"/>
                    <ui:TextBox Margin="24,8,0,0"
                                PlaceholderText="e.g. 9.9.9.9, 1.1.1.1"
                                Text="{Binding CustomNameservers, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding IsCustomDns}"
                                AutomationProperties.Name="Custom DNS nameservers"/>
                </StackPanel>
            </Border>

            <!-- HTB VPN card (security distributions only) -->
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20,16" Margin="0,0,0,12"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="{Binding ShowHtbVpn, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Hack The Box VPN" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Enter your HTB App Token to download VPN keys for all platforms, or browse for a .ovpn file."
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"
                               TextWrapping="Wrap"/>

                    <!-- API Token input -->
                    <TextBlock Text="App Token  (from app.hackthebox.com/profile/settings)" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" PlaceholderText="Paste your HTB App Token..."
                                    Text="{Binding HtbApiToken, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="HTB API Token"/>
                        <Button Grid.Column="1" Content="Download VPN Keys"
                                Command="{Binding DownloadVpnKeysCommand}"
                                Margin="8,0,0,0" Padding="12,6"
                                AutomationProperties.Name="Download VPN keys from HTB"/>
                    </Grid>

                    <!-- Download status list -->
                    <ItemsControl ItemsSource="{Binding VpnKeyStatuses}" Margin="0,0,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <TextBlock Text="{Binding StatusIcon}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Manual fallback -->
                    <TextBlock Text="Or select a .ovpn file manually:" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" PlaceholderText="Path to .ovpn file..."
                                    Text="{Binding OvpnFilePath, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="OpenVPN configuration file path"/>
                        <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseOvpnCommand}"
                                Margin="8,0,0,0" Padding="12,6"
                                AutomationProperties.Name="Browse for OVPN file"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Distribution-specific options (dynamically populated from plugin assemblies) -->
            <ItemsControl ItemsSource="{Binding DistributionOptions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="8" Padding="20,16" Margin="0,0,0,12"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding CardTitle}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding CardDescription}"
                                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"
                                           TextWrapping="Wrap"/>
                                <CheckBox Content="{Binding Label}"
                                          IsChecked="{Binding IsEnabled}"
                                          FontSize="14"
                                          ToolTip="{Binding Tooltip}"
                                          AutomationProperties.Name="{Binding Label}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Advanced: SSH Key card (Linux only) -->
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20,16" Margin="0,0,0,12"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="{Binding ShowLinuxOptions, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Advanced" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Override the auto-generated SSH key used for post-boot VM configuration."
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"/>
                    <CheckBox Content="Use custom SSH public key"
                              IsChecked="{Binding UseCustomSshKey}"
                              FontSize="14"
                              ToolTip="By default, VMCreate generates a per-user Ed25519 keypair. Enable this to provide your own SSH public key instead."
                              AutomationProperties.Name="Use custom SSH key"/>
                    <Grid Margin="24,8,0,0" IsEnabled="{Binding IsSshKeyPathEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" PlaceholderText="Path to .pub file..."
                                    Text="{Binding CustomSshPublicKeyPath, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="SSH public key file path"/>
                        <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseSshKeyCommand}"
                                Margin="8,0,0,0" Padding="12,6"
                                AutomationProperties.Name="Browse for SSH public key"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="&lt; Back" Command="{Binding BackCommand}" Style="{StaticResource CommonButton}"
                    AutomationProperties.Name="Go back"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource CommonButton}" Margin="5,0,0,0"
                    AutomationProperties.Name="Cancel wizard"/>
            <ui:Button Command="{Binding FinishCommand}" Appearance="Primary"
                    FontSize="14" Margin="9,4,4,4" Padding="12,8"
                    AutomationProperties.Name="Deploy virtual machine">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Deploy" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                    <ui:SymbolIcon Symbol="Rocket24" Margin="6,0,0,0"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                </StackPanel>
            </ui:Button>
        </StackPanel>
    </Grid>
</Page>
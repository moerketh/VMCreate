<ui:FluentWindow x:Class="VMCreate.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Settings"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid Margin="16,48,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Machine-level settings — applied to every new VM. Secrets are stored encrypted (DPAPI)."
                   TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="520">
            <StackPanel>

                <!-- ── Security ─────────────────────────────────── -->
                <TextBlock Text="Security" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="HTB App Token — used to download VPN keys; asked once, never per VM." FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                <PasswordBox x:Name="HtbTokenBox" Margin="0,0,0,16"/>

                <!-- ── AI ───────────────────────────────────────── -->
                <TextBlock Text="AI / LLM" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="OpenAI-compatible chat-completions endpoint used to AI-enable Elastic SIEM deployments (OpenAI, Azure, or a local vLLM/Ollama/LM Studio server)." FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <ui:TextBox x:Name="LlmUrlBox" PlaceholderText="https://api.openai.com/v1/chat/completions" Margin="0,0,0,6"/>
                <PasswordBox x:Name="LlmKeyBox" Margin="0,0,0,6"
                             ToolTip="API key. For local LLMs without auth, any non-empty dummy value works."/>
                <ui:TextBox x:Name="LlmModelBox" PlaceholderText="Model name (e.g. gpt-4o)" Margin="0,0,0,16"/>

                <!-- ── Console resolution ─────────────────────────── -->
                <TextBlock Text="Console resolution" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="Resolution forced on Linux graphical consoles (Lamco RDP backend). Sane defaults over the Hyper-V synthetic display — pick something smaller for laptops, larger for big screens." FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <ComboBox x:Name="ConsoleResolutionBox" Margin="0,0,0,16"
                          ToolTip="Console resolution &amp; refresh rate forced on Lamco graphical consoles, formatted WxH@Hz. Unsupported modes fall back to the in-guest default.">
                    <ComboBoxItem Content="1280x720 — small laptop" Tag="1280x720@60"/>
                    <ComboBoxItem Content="1360x768 — laptop" Tag="1360x768@60"/>
                    <ComboBoxItem Content="1600x900 — standard desktop" Tag="1600x900@60"/>
                    <ComboBoxItem Content="1920x1080 — Full HD (default)" Tag="1920x1080@60"/>
                    <ComboBoxItem Content="1920x1200 — Full HD+ big screen" Tag="1920x1200@60"/>
                </ComboBox>

                <!-- ── Network ──────────────────────────────────── -->
                <TextBlock Text="Network" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <StackPanel Margin="0,0,0,4">
                    <RadioButton x:Name="DnsHostRadio" Content="Use host DNS servers (default)"/>
                    <RadioButton x:Name="DnsCustomRadio" Content="Custom nameservers"/>
                </StackPanel>
                <ui:TextBox x:Name="DnsNameserversBox" PlaceholderText="9.9.9.9,1.1.1.1" Margin="24,6,0,16"/>

                <!-- ── VM defaults ──────────────────────────────── -->
                <TextBlock Text="VM defaults" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="The wizard starts every run from these values; each VM can still deviate." FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                <ComboBox x:Name="RdpBackendBox" Margin="0,0,0,6"
                          ToolTip="Remote desktop backend pre-selected on the customization page.">
                    <ComboBoxItem Content="Auto detect (recommended)" Tag="Auto"/>
                    <ComboBoxItem Content="xrdp — forces X11 for maximum compatibility" Tag="Xrdp"/>
                    <ComboBoxItem Content="Lamco RDP Server — Wayland-native (Debian family)" Tag="Lamco"/>
                    <ComboBoxItem Content="None — console/SSH only" Tag="None"/>
                </ComboBox>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Memory (MB)" FontSize="12" Opacity="0.7"/>
                        <ui:TextBox x:Name="MemoryBox" PlaceholderText="4096"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,6,0">
                        <TextBlock Text="vCPUs" FontSize="12" Opacity="0.7"/>
                        <ui:TextBox x:Name="CpuBox" PlaceholderText="2"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Disk (GB)" FontSize="12" Opacity="0.7"/>
                        <ui:TextBox x:Name="DiskBox" PlaceholderText="150"/>
                    </StackPanel>
                </Grid>

                <!-- ── Advanced ─────────────────────────────────── -->
                <Expander Header="Advanced" Margin="0,0,0,8">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="qemu-img.exe path (disk conversion)" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="QemuPathBox" PlaceholderText="C:\Program Files\qemu\qemu-img.exe (default)" Margin="0,0,0,10"/>
                        <TextBlock Text="Extraction temp directory" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="ExtractPathBox" PlaceholderText="%TEMP%\VMExtracted (default)" Margin="0,0,0,4"/>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <ui:Button Content="Cancel" Appearance="Secondary" Margin="0,0,8,0" Click="Cancel_Click"/>
            <ui:Button Content="Save" Appearance="Primary" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>

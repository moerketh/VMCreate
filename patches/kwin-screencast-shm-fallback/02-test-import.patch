@@ -945,6 +945,13 @@ std::optional<ScreenCastDmaBufTextureParams> ScreenCastStream::testCreateDmaBuf(c
     if (!attrs) {
         return std::nullopt;
     }
 
+    // Test if EGL can actually import the DMA-BUF as a texture.
+    // On virtual GPUs with software rendering, the allocator may produce
+    // a DMA-BUF but EGL_EXT_image_dma_buf_import may fail (EGL_BAD_MATCH).
+    // In that case, don't advertise DMA-BUF support — fall back to SHM/MemFd.
+    auto texture = backend->importDmaBufAsTexture(*attrs);
+    if (!texture) {
+        qCWarning(KWIN_SCREENCAST) << "testCreateDmaBuf: EGL DMA-BUF import failed, disabling DMA-BUF screencast";
+        return std::nullopt;
+    }

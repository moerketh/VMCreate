<Project>
  <PropertyGroup>
    <Company>moerketh</Company>
    <Authors>moerketh</Authors>
    <Product>VMCreate</Product>
    <Copyright>Copyright © moerketh $([System.DateTime]::Now.Year)</Copyright>
    <!-- MinVer reads the nearest git tag (e.g. v1.0.0) to set Version automatically.
         Without a tag, defaults to 0.0.0-alpha.0.{height}. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <!-- The app is English-only; dependency satellite assemblies (WPF-UI,
         PowerShell SDK translations — cs de es fr it ja ko pl pt-BR ru tr
         zh-Hans zh-Hant, ~20 MB across the publish) are dead weight in
         every shipped binary. Keep only the neutral (English) resources. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- MinVer only works with SDK-style .NET projects, not WiX -->
  <ItemGroup Condition="'$(MSBuildProjectExtension)' != '.wixproj'">
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="all" />
  </ItemGroup>
</Project>

<ui:FluentWindow x:Class="VMCreate.Manager.StorageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Storage" Width="1150" Height="720" MinWidth="720" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <ui:FluentWindow.Resources>
        <!-- Every grid scrolls itself, virtualized, by pixel. -->
        <Style TargetType="DataGrid" BasedOn="{StaticResource DefaultDataGridStyle}">
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        </Style>
    </ui:FluentWindow.Resources>
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="Storage"/>
        <DockPanel DockPanel.Dock="Top" Margin="14,4,14,8">
            <ui:Button x:Name="ScanButton" DockPanel.Dock="Left" Icon="{ui:SymbolIcon ArrowClockwise24}" Content="Scan again"
                       Click="Scan_Click" Margin="0,0,12,0"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}"
                       TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <TextBlock x:Name="FooterText" DockPanel.Dock="Bottom" Margin="14,6,14,8" FontSize="11"
                   Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis"/>

        <TabControl x:Name="Tabs" Margin="14,0,14,0">
            <!-- Overview -->
            <TabItem x:Name="OverviewTab" Header="Overview">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*" MinHeight="120"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="90"/>
                    </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                            <ui:CardAction x:Name="OrphanCard" Width="250" Margin="0,0,10,0" Icon="{ui:SymbolIcon Broom24}" Click="OrphanCard_Click">
                                <StackPanel>
                                    <TextBlock Text="Unused files" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="OrphanSummary" Foreground="{StaticResource SubtleTextBrush}" Text="…"/>
                                </StackPanel>
                            </ui:CardAction>
                            <ui:CardAction x:Name="MissingCard" Width="250" Margin="0,0,10,0" Icon="{ui:SymbolIcon DocumentDismiss24}" Click="MissingCard_Click">
                                <StackPanel>
                                    <TextBlock Text="Missing files" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="MissingSummary" Foreground="{StaticResource SubtleTextBrush}" Text="…"/>
                                </StackPanel>
                            </ui:CardAction>
                            <ui:Card Width="300" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Old checkpoints" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock x:Name="OldCheckpointSummary" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" Text="…"/>
                                        <TextBlock Text="  older than " VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}"/>
                                        <ui:NumberBox x:Name="OldDaysBox" Width="80" SpinButtonPlacementMode="Hidden" Minimum="1" Maximum="3650" SmallChange="1" LargeChange="30"
                                                      MaxDecimalPlaces="0" ClearButtonEnabled="False" ValueChanged="OldDays_Changed"/>
                                        <TextBlock Text=" days" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:Card>
                        </WrapPanel>

                        <TextBlock Grid.Row="1" Text="DRIVES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}" Margin="2,0,0,4"/>
                        <DataGrid x:Name="VolumesGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="None" Margin="0,0,0,14" MaxHeight="180">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Drive" Binding="{Binding Root}" Width="70"/>
                                <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="140"/>
                                <DataGridTemplateColumn Header="Used" Width="200" SortMemberPath="UsedFraction">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4,8,4">
                                                <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="6" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Free" Binding="{Binding Free}" SortMemberPath="FreeBytes" Width="140"/>
                                <DataGridTextColumn Header="VM disks" Binding="{Binding VmDisks}" SortMemberPath="VmBytes" Width="110"/>
                                <DataGridTextColumn Header="Unused" Binding="{Binding Unused}" SortMemberPath="OrphanBytes" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="3" Text="VIRTUAL MACHINES (virtual disks, including parents and checkpoint disks)" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource SubtleTextBrush}" Margin="2,0,0,4"/>
                        <DataGrid x:Name="VmsGrid" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="None" Margin="0,0,0,14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="VM" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Own disks" Binding="{Binding Own}" SortMemberPath="OwnBytes" Width="110"/>
                                <DataGridTextColumn Header="Shared" Binding="{Binding Shared}" SortMemberPath="SharedBytes" Width="110"/>
                                <DataGridTextColumn Header="Checkpoints" Binding="{Binding Checkpoints}" Width="100"/>
                                <DataGridTextColumn Header="Oldest checkpoint" Binding="{Binding Oldest}" SortMemberPath="OldestCheckpoint" Width="140"/>
                                <DataGridTextColumn Header="Missing files" Binding="{Binding Missing}" SortMemberPath="MissingFiles" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock x:Name="OldCheckpointsHeader" Grid.Row="5" Text="OLD CHECKPOINTS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource SubtleTextBrush}" Margin="2,0,0,4"/>
                        <DataGrid x:Name="OldCheckpointsGrid" Grid.Row="6" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="None">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="VM" Binding="{Binding VmName}" Width="2*"/>
                                <DataGridTextColumn Header="Checkpoint" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
                                <DataGridTextColumn Header="Age (days)" Binding="{Binding AgeDays}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                </Grid>
            </TabItem>

            <!-- Unused files -->
            <TabItem x:Name="OrphansTab" Header="Unused files">
                <DockPanel Margin="0,10,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <ui:Button x:Name="DeleteButton" DockPanel.Dock="Left" Icon="{ui:SymbolIcon Delete24}" Content="Delete selected…"
                                   Appearance="Danger" Click="Delete_Click" Margin="0,0,8,0"/>
                        <ui:Button DockPanel.Dock="Left" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Show in Explorer"
                                   Appearance="Transparent" Padding="6" Click="OpenFolder_Click"/>
                        <ui:Button DockPanel.Dock="Left" Icon="{ui:SymbolIcon Copy24}" ToolTip="Copy the paths"
                                   Appearance="Transparent" Padding="6" Margin="0,0,12,0" Click="CopyPaths_Click"/>
                        <CheckBox x:Name="PermanentBox" DockPanel.Dock="Left" Content="Delete permanently (skip the Recycle Bin)"
                                  VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ui:TextBox x:Name="OrphanSearch" PlaceholderText="Filter by path, type or note…" Icon="{ui:SymbolIcon Search24}"
                                    TextChanged="OrphanSearch_TextChanged"/>
                    </DockPanel>
                    <Expander DockPanel.Dock="Bottom" Header="Searched folders" Margin="0,8,0,0">
                        <DockPanel Margin="0,6,0,0">
                            <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                                <ui:Button Icon="{ui:SymbolIcon FolderAdd24}" Content="Add folder…" Click="AddFolder_Click" HorizontalAlignment="Stretch"/>
                                <ui:Button Content="Remove" Click="RemoveFolder_Click" HorizontalAlignment="Stretch" Margin="0,6,0,0"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Bottom" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       Text="Hyper-V's default folders, every VM's folders and the folders holding their disks are always searched. ISOs only count inside Hyper-V's and the VMs' folders and folders you add. Disks of WSL, Docker and Windows Sandbox, and archives made here, are skipped. Files another program holds open are never deleted."/>
                            <ListBox x:Name="FoldersList" MaxHeight="140"/>
                        </DockPanel>
                    </Expander>
                    <DataGrid x:Name="OrphansGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="None" SelectionMode="Extended" SelectionChanged="OrphansGrid_SelectionChanged"
                              MouseDoubleClick="OpenFolder_Click">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InUse}" Value="True">
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" SortMemberPath="SizeBytes" Width="90"/>
                            <DataGridTextColumn Header="Last changed" Binding="{Binding LastChanged}" SortMemberPath="LastWriteUtc" Width="125"/>
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="3*"/>
                            <DataGridTextColumn Header="Why" Binding="{Binding Reason}" Width="*"/>
                            <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Missing files -->
            <TabItem x:Name="MissingTab" Header="Missing files">
                <DockPanel Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}"
                               Text="Files a VM or checkpoint refers to that are not there, or that Hyper-V cannot read. A VM with a missing disk or parent disk will not start; a missing ISO only matters when booting from it."/>
                    <DataGrid x:Name="MissingGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="VM" Binding="{Binding VmName}" Width="*"/>
                            <DataGridTextColumn Header="Checkpoint" Binding="{Binding CheckpointName}" Width="*"/>
                            <DataGridTextColumn Header="Problem" Binding="{Binding Problem}" Width="*"/>
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Metadata of VMs that no longer exist -->
            <TabItem x:Name="StaleTab" Header="Old metadata">
                <DockPanel Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}"
                               Text="Folder, tags, description and saved credentials of VMs that are no longer on this host, for example removed with Remove-VM or Hyper-V Manager. Nothing is removed automatically: a VM imported again with the same ID gets its metadata back."/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:Button x:Name="RemoveStaleButton" Icon="{ui:SymbolIcon Delete24}" Content="Remove selected…"
                                   Appearance="Danger" Click="RemoveStale_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="StaleGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="None" SelectionMode="Extended" SelectionChanged="StaleGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="VM" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen}" SortMemberPath="LastSeenOn" Width="100"/>
                            <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="*"/>
                            <DataGridTextColumn Header="Purpose" Binding="{Binding Purpose}" Width="2*"/>
                            <DataGridTextColumn Header="Credentials" Binding="{Binding Credentials}" Width="95"/>
                            <DataGridTextColumn Header="VM ID" Binding="{Binding VmId}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Skipped -->
            <TabItem x:Name="SkippedTab" Header="Skipped">
                <DockPanel Margin="0,10,0,0">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}"
                               Text="What the search deliberately left alone, and folders it could not read."/>
                    <DataGrid x:Name="SkippedGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2*"/>
                            <DataGridTextColumn Header="Why" Binding="{Binding Reason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</ui:FluentWindow>

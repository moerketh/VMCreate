<ui:FluentWindow x:Class="VMCreate.Manager.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <StackPanel>
        <ui:TitleBar x:Name="DialogTitleBar" ShowMinimize="False" ShowMaximize="False"/>
        <StackPanel Margin="20,4,20,20">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <ui:TextBox x:Name="ValueBox" KeyDown="ValueBox_KeyDown"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="OK" Appearance="Primary" MinWidth="90" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0"/>
                <ui:Button Content="Cancel" MinWidth="90" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>

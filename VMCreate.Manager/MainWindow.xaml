<ui:FluentWindow x:Class="VMCreate.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:VMCreate.Manager.ViewModels"
        xmlns:local="clr-namespace:VMCreate.Manager"
        Title="VMCreate Manager" Height="780" Width="1400"
        MinWidth="980" MinHeight="560"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <!-- Right-click menu of a folder node. Tag of the placement target carries the MainViewModel;
             right-clicking selects the node first, so the commands act on SelectedNode. -->
        <ContextMenu x:Key="FolderContextMenu" x:Shared="False">
            <MenuItem Header="New subfolder…" Icon="{ui:SymbolIcon FolderAdd24}"
                      Command="{Binding PlacementTarget.Tag.NewFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Rename…" Icon="{ui:SymbolIcon Rename24}"
                      Command="{Binding PlacementTarget.Tag.RenameFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Delete folder" Icon="{ui:SymbolIcon Delete24}"
                      Command="{Binding PlacementTarget.Tag.DeleteFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Set expiry…" Icon="{ui:SymbolIcon CalendarClock24}"
                      Command="{Binding PlacementTarget.Tag.SetFolderExpiryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Archive…" Icon="{ui:SymbolIcon Archive24}"
                      ToolTip="Export every VM in this folder with a checksummed manifest, then optionally delete them"
                      Command="{Binding PlacementTarget.Tag.ArchiveFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="Color" Icon="{ui:SymbolIcon Color24}" ItemsSource="{x:Static local:FolderPalette.Options}">
                <MenuItem.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:FolderColorOption}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="Swatch" Width="12" Height="12" VerticalAlignment="Center"
                                     Fill="{Binding Hex, Converter={StaticResource HexToBrush}}"
                                     Stroke="{StaticResource SubtleTextBrush}" StrokeThickness="1"/>
                            <TextBlock Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Hex}" Value="{x:Null}">
                                <Setter TargetName="Swatch" Property="Fill" Value="Transparent"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </MenuItem.ItemTemplate>
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <EventSetter Event="Click" Handler="FolderColor_Click"/>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
        </ContextMenu>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="VMCreate Manager">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Server24"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Messages -->
        <StackPanel Grid.Row="1" Margin="12,0,12,4">
            <ui:InfoBar Title="Error" Severity="Error" IsClosable="True"
                        IsOpen="{Binding IsErrorOpen, Mode=TwoWay}"
                        Message="{Binding ErrorMessage}"/>
            <Border Visibility="{Binding ExpiredCount, Converter={StaticResource CountToVis}}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="12,8" Margin="0,4,0,0">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Content="Show" Command="{Binding ShowExpiredCommand}"/>
                    <ui:SymbolIcon Symbol="CalendarCancel16" Foreground="#E8B33A" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                        <Run Text="{Binding ExpiredCount, Mode=OneWay}"/>
                        <Run Text="VM(s) are past their expiry date. Nothing is deleted automatically: archive or delete them when the engagement is done."/>
                    </TextBlock>
                </DockPanel>
            </Border>
            <Border Visibility="{Binding LegacyCredentialCount, Converter={StaticResource CountToVis}}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="12,8" Margin="0,4,0,0">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Content="Move to encrypted store" Appearance="Primary"
                               Command="{Binding MigrateLegacyCredentialsCommand}"/>
                    <ui:SymbolIcon Symbol="Warning24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                        <Run Text="{Binding LegacyCredentialCount, Mode=OneWay}"/>
                        <Run Text="VM(s) have plaintext credentials in their Hyper-V Notes (written by older VMCreate versions)."/>
                    </TextBlock>
                </DockPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="250" MinWidth="180"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition x:Name="DetailsColumn" Width="380" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: folders ─────────────────────────────── -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <ui:Button Icon="{ui:SymbolIcon FolderAdd24}" Command="{Binding NewFolderCommand}" ToolTip="New folder (inside the selected folder)" Appearance="Transparent" Padding="6"/>
                    <ui:Button Icon="{ui:SymbolIcon Rename24}" Command="{Binding RenameFolderCommand}" ToolTip="Rename folder" Appearance="Transparent" Padding="6"/>
                    <ui:Button Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeleteFolderCommand}" ToolTip="Delete folder (VMs move up, nothing is deleted)" Appearance="Transparent" Padding="6"/>
                </StackPanel>
                <TreeView x:Name="NavTree" ItemsSource="{Binding Navigation}"
                          SelectedItemChanged="NavTree_SelectedItemChanged"
                          AllowDrop="True" DragOver="NavTree_DragOver" Drop="NavTree_Drop"
                          PreviewMouseLeftButtonDown="NavTree_PreviewMouseLeftButtonDown"
                          PreviewMouseRightButtonDown="NavTree_PreviewMouseRightButtonDown"
                          PreviewMouseMove="NavTree_PreviewMouseMove">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:NavNodeViewModel}" ItemsSource="{Binding Children}">
                            <DockPanel Background="Transparent"
                                       Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}">
                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:NavNodeKind.Folder}">
                                                <Setter Property="ContextMenu" Value="{StaticResource FolderContextMenu}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{StaticResource SubtleTextBrush}" Margin="8,0,0,0"/>
                                <ui:SymbolIcon DockPanel.Dock="Right" Symbol="CalendarClock24" FontSize="13" Margin="6,0,0,0"
                                               ToolTip="{Binding ExpiryText}"
                                               Visibility="{Binding ExpiresOn, Converter={StaticResource NullToVis}}">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                    <Setter Property="Foreground" Value="#E8B33A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <ui:SymbolIcon Symbol="{Binding Icon}" Margin="0,0,6,0"
                                               Foreground="{Binding Color, Converter={StaticResource HexToBrush}}"/>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DockPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- ── Center: VM grid ───────────────────────────── -->
            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ui:Button Icon="{ui:SymbolIcon Play24}" Command="{Binding StartCommand}" ToolTip="Start" Appearance="Transparent" Padding="6"/>
                        <ui:Button Icon="{ui:SymbolIcon Power24}" Command="{Binding ShutdownCommand}" ToolTip="Shut down (guest OS)" Appearance="Transparent" Padding="6"/>
                        <ui:Button Icon="{ui:SymbolIcon Stop24}" Command="{Binding TurnOffCommand}" ToolTip="Turn off (hard power off)" Appearance="Transparent" Padding="6"/>
                        <ui:Button Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveStateCommand}" ToolTip="Save state" Appearance="Transparent" Padding="6"/>
                        <ui:Button Icon="{ui:SymbolIcon Pause24}" Command="{Binding PauseCommand}" ToolTip="Pause" Appearance="Transparent" Padding="6"/>
                        <ui:Button Icon="{ui:SymbolIcon Play24}" Command="{Binding ResumeCommand}" ToolTip="Resume" Appearance="Transparent" Padding="6" Content="Resume"/>
                        <ui:Button Icon="{ui:SymbolIcon Desktop24}" Command="{Binding ConnectCommand}" ToolTip="Connect (vmconnect)" Appearance="Transparent" Padding="6"/>
                        <ui:Button Icon="{ui:SymbolIcon WindowConsole20}" Command="{Binding SshCommand}" ToolTip="Open SSH (over the network when the VM has an IP, otherwise over vsock)" Appearance="Transparent" Padding="6"/>
                        <ui:Button Icon="{ui:SymbolIcon Copy24}" Command="{Binding CopyIpCommand}" ToolTip="Copy IP address" Appearance="Transparent" Padding="6"/>
                        <ui:Button Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshCommand}" ToolTip="Refresh" Appearance="Transparent" Padding="6"/>
                        <ui:Button Icon="{ui:SymbolIcon History24}" Click="OpenActivityLog_Click" ToolTip="Activity log (who did what, when)" Appearance="Transparent" Padding="6"/>
                        <ui:Button Icon="{ui:SymbolIcon HardDrive20}" Click="OpenStorage_Click" ToolTip="Storage: disk use, unused files, missing files" Appearance="Transparent" Padding="6"/>
                    </StackPanel>
                    <ui:TextBox PlaceholderText="Search name, purpose, tags, description, IP…"
                                Icon="{ui:SymbolIcon Search24}"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,8,0"/>
                </DockPanel>
                <Grid>
                    <DataGrid x:Name="VmGrid" ItemsSource="{Binding VmsView}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True"
                              SelectionChanged="VmGrid_SelectionChanged"
                              MouseDoubleClick="VmGrid_MouseDoubleClick"
                              PreviewMouseLeftButtonDown="VmGrid_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="VmGrid_PreviewMouseMove">
                        <DataGrid.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Connect" Command="{Binding ConnectCommand}" Icon="{ui:SymbolIcon Desktop24}"/>
                                <MenuItem Header="SSH" Command="{Binding SshCommand}" Icon="{ui:SymbolIcon WindowConsole20}"/>
                                <MenuItem Header="SSH over network" Command="{Binding SshNetworkCommand}"/>
                                <MenuItem Header="SSH over vsock" Command="{Binding SshVsockCommand}"/>
                                <MenuItem Header="Copy IP address" Command="{Binding CopyIpCommand}" Icon="{ui:SymbolIcon Copy24}"/>
                                <Separator/>
                                <MenuItem Header="Start" Command="{Binding StartCommand}" Icon="{ui:SymbolIcon Play24}"/>
                                <MenuItem Header="Shut down" Command="{Binding ShutdownCommand}" Icon="{ui:SymbolIcon Power24}"/>
                                <MenuItem Header="Turn off" Command="{Binding TurnOffCommand}" Icon="{ui:SymbolIcon Stop24}"/>
                                <MenuItem Header="Save state" Command="{Binding SaveStateCommand}" Icon="{ui:SymbolIcon Save24}"/>
                                <MenuItem Header="Pause" Command="{Binding PauseCommand}" Icon="{ui:SymbolIcon Pause24}"/>
                                <MenuItem Header="Resume" Command="{Binding ResumeCommand}"/>
                                <Separator/>
                                <MenuItem Header="New linked clone…" Command="{Binding NewLinkedCloneCommand}" Icon="{ui:SymbolIcon BranchFork20}"/>
                                <MenuItem Header="Make template" Command="{Binding MarkTemplateCommand}" Icon="{ui:SymbolIcon Layer20}"/>
                                <MenuItem Header="Unmark template" Command="{Binding UnmarkTemplateCommand}"/>
                                <Separator/>
                                <MenuItem Header="Network" Icon="{ui:SymbolIcon VirtualNetwork20}">
                                    <MenuItem Header="Isolate now" Command="{Binding IsolateNetworkCommand}" Icon="{ui:SymbolIcon PlugDisconnected24}"
                                              ToolTip="Disconnect every network adapter; Restore puts them back"/>
                                    <MenuItem Header="Restore network" Command="{Binding RestoreNetworkCommand}" Icon="{ui:SymbolIcon PlugConnected24}"/>
                                    <Separator/>
                                    <MenuItem Header="Connect all adapters to" ItemsSource="{Binding SwitchOptions}">
                                        <MenuItem.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="{Binding Exposure, Converter={StaticResource Exposure}}" FontSize="14"
                                                                   Foreground="{Binding Exposure, Converter={StaticResource Exposure}, ConverterParameter=Brush}"/>
                                                    <TextBlock Text="{Binding Label}" Margin="8,0,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </MenuItem.ItemTemplate>
                                        <MenuItem.ItemContainerStyle>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                <Setter Property="Command" Value="{Binding DataContext.ConnectToSwitchCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <Setter Property="CommandParameter" Value="{Binding}"/>
                                            </Style>
                                        </MenuItem.ItemContainerStyle>
                                    </MenuItem>
                                </MenuItem>
                                <MenuItem Header="Move to folder" Icon="{ui:SymbolIcon FolderArrowRight24}" ItemsSource="{Binding FolderOptions}">
                                    <MenuItem.ItemContainerStyle>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                            <Setter Property="Header" Value="{Binding Path}"/>
                                            <Setter Property="Command" Value="{Binding DataContext.MoveSelectedToFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <Setter Property="CommandParameter" Value="{Binding}"/>
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Delete VM and disks…" Command="{Binding DeleteVmCommand}" Icon="{ui:SymbolIcon Delete24}"
                                          InputGestureText="Del"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.InputBindings>
                            <KeyBinding Key="Delete" Command="{Binding DeleteVmCommand}"/>
                        </DataGrid.InputBindings>
                        <!-- Folder groups, only active in "All virtual machines" (see MainViewModel.UpdateGrouping). -->
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <StackPanel>
                                                        <ToggleButton x:Name="GroupToggle" IsChecked="True" Cursor="Hand"
                                                                      Loaded="GroupToggle_Loaded"
                                                                      Checked="GroupToggle_Changed" Unchecked="GroupToggle_Changed">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border Background="Transparent" Padding="6,8,6,4"
                                                                            BorderThickness="0,0,0,1" BorderBrush="{StaticResource ItemBorderBrush}">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon x:Name="Chevron" Symbol="ChevronDown16" FontSize="12"
                                                                               Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
                                                                <ui:SymbolIcon x:Name="FolderIcon" Symbol="Folder24" FontSize="16"
                                                                               Margin="8,0,6,0" VerticalAlignment="Center"
                                                                               Foreground="{Binding Items[0].FolderColor, Converter={StaticResource HexToBrush}}"/>
                                                                <TextBlock Text="{Binding Name, Converter={StaticResource FolderGroupName}}"
                                                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}"
                                                                           Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </ToggleButton>
                                                        <ItemsPresenter x:Name="GroupItems"/>
                                                    </StackPanel>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger SourceName="GroupToggle" Property="IsChecked" Value="False">
                                                            <Setter TargetName="GroupItems" Property="Visibility" Value="Collapsed"/>
                                                            <Setter TargetName="Chevron" Property="Symbol" Value="ChevronRight16"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding Name}" Value="">
                                                            <Setter TargetName="FolderIcon" Property="Symbol" Value="FolderProhibited24"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Name" SortMemberPath="Name" Width="2*" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Grid Width="24" Height="22" Margin="0,0,8,0" ToolTip="{Binding StateText}">
                                                <ui:SymbolIcon Symbol="{Binding State, Converter={StaticResource StateSymbol}}" FontSize="20"
                                                               Foreground="{Binding State, Converter={StaticResource StateBrush}}"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="6" Padding="1"
                                                        Background="{DynamicResource ApplicationBackgroundBrush}"
                                                        Visibility="{Binding State, Converter={StaticResource StateSymbol}, ConverterParameter=Badge}">
                                                    <ui:SymbolIcon Symbol="{Binding State, Converter={StaticResource StateSymbol}, ConverterParameter=Badge}" FontSize="11"
                                                                   Foreground="{Binding State, Converter={StaticResource StateBrush}}"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            <ui:SymbolIcon Symbol="Layer20" FontSize="14" Margin="6,0,0,0" Foreground="#5B9BE6"
                                                           ToolTip="Template for linked clones"
                                                           Visibility="{Binding IsTemplate, Converter={StaticResource BoolToVis}}"/>
                                            <ui:SymbolIcon Symbol="BranchFork16" Margin="6,0,0,0" Foreground="{StaticResource SubtleTextBrush}"
                                                           ToolTip="Linked clone"
                                                           Visibility="{Binding TemplateId, Converter={StaticResource NullToVis}}"/>
                                            <ui:SymbolIcon Symbol="{Binding Exposure, Converter={StaticResource Exposure}}" FontSize="14" Margin="6,0,0,0"
                                                           Foreground="{Binding Exposure, Converter={StaticResource Exposure}, ConverterParameter=Brush}"
                                                           ToolTip="{Binding ExposureText}"/>
                                            <ui:SymbolIcon Symbol="ShieldLock16" Margin="6,0,0,0" ToolTip="Delete protection on"
                                                           Visibility="{Binding Protected, Converter={StaticResource BoolToVis}}"/>
                                            <ui:SymbolIcon Symbol="CalendarCancel16" Margin="6,0,0,0" ToolTip="{Binding ExpiryText}" Foreground="#E8B33A"
                                                           Visibility="{Binding IsExpired, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="90"/>
                            <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" Width="55"/>
                            <DataGridTextColumn Header="Memory" Binding="{Binding MemoryText}" Width="75"/>
                            <DataGridTextColumn Header="Uptime" Binding="{Binding UptimeText}" Width="85"/>
                            <DataGridTextColumn Header="IP address" Binding="{Binding PrimaryIp}" Width="*" MinWidth="115"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ui:ProgressRing IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- ── Right: details ────────────────────────────── -->
            <Border Grid.Column="4" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="14,10">
                <Grid>
                    <TextBlock Text="Select one VM to see and edit its details."
                               Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Editor, Converter={StaticResource InverseNullToVis}}"/>
                    <DockPanel DataContext="{Binding Editor}" Visibility="{Binding Converter={StaticResource NullToVis}}">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <ui:Button Content="Revert" Command="{Binding DataContext.RevertEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,8,0"/>
                            <ui:Button Content="Save" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Command="{Binding DataContext.SaveEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,0">
                                <!-- Console preview: click to connect -->
                                <Border CornerRadius="6" ClipToBounds="True" Background="Black" Cursor="Hand" Margin="0,0,0,8"
                                        ToolTip="Live console preview — click to connect"
                                        DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding ConnectCommand}"/>
                                    </Border.InputBindings>
                                    <Grid MinHeight="180">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding ThumbnailMessage, Converter={StaticResource NullToVis}}">
                                            <ui:SymbolIcon Symbol="{Binding SelectedVm.State, Converter={StaticResource StateSymbol}}" FontSize="40"
                                                           Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding ThumbnailMessage}" Foreground="{StaticResource SubtleTextBrush}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Name" Margin="0,0,0,2"/>
                                <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Purpose"/>
                                <ui:TextBox Text="{Binding Purpose, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="What is this VM for?"/>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Folder"/>
                                <ComboBox ItemsSource="{Binding DataContext.FolderOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          DisplayMemberPath="Path" SelectedValuePath="Id"
                                          SelectedValue="{Binding FolderId}"/>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Tags (comma separated)"/>
                                <ui:TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="kali, external, acme"/>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Description"/>
                                <ui:TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                            AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" VerticalContentAlignment="Top"/>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Delete protection" Margin="0,0,0,2"/>
                                        <ui:ToggleSwitch IsChecked="{Binding Protected}" OnContent="Protected" OffContent="Off"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Expires on" Margin="0,0,0,2"/>
                                        <DatePicker SelectedDate="{Binding ExpiresOn}"/>
                                        <TextBlock Text="{Binding InheritedExpiryText}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"
                                                   Foreground="{StaticResource SubtleTextBrush}"
                                                   Visibility="{Binding InheritedExpiryText, Converter={StaticResource NullToVis}}"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Visibility="{Binding HasCredential, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="CREDENTIALS"/>
                                    <TextBlock>
                                        <Run Text="User:" Foreground="{StaticResource SubtleTextBrush}"/>
                                        <Run Text="{Binding Username, Mode=OneWay}"/>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding HasPassword, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Password:" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding RevealedPassword, TargetNullValue='••••••••'}" VerticalAlignment="Center" FontFamily="Consolas" Margin="0,0,8,0"/>
                                        <ui:Button Icon="{ui:SymbolIcon Eye24}" Appearance="Transparent" Padding="4" ToolTip="Show / hide"
                                                   Command="{Binding DataContext.RevealPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <ui:Button Icon="{ui:SymbolIcon Copy24}" Appearance="Transparent" Padding="4" ToolTip="Copy password"
                                                   Command="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Visibility="{Binding LineageText, Converter={StaticResource NullToVis}}">
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="LINKED CLONES"/>
                                    <TextBlock Text="{Binding LineageText}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding Provenance, Converter={StaticResource NullToVis}}">
                                    <TextBlock Style="{StaticResource SectionHeader}" Text="BUILT BY VMCREATE"/>
                                    <TextBlock Text="{Binding ProvenanceText}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <TextBlock Style="{StaticResource SectionHeader}" Text="HARDWARE &amp; NETWORK"/>
                                <TextBlock TextWrapping="Wrap" LineHeight="20">
                                    <Run Text="Generation" Foreground="{StaticResource SubtleTextBrush}"/> <Run Text="{Binding Summary.Generation, Mode=OneWay}"/>
                                    <Run Text="  ·  vCPU" Foreground="{StaticResource SubtleTextBrush}"/> <Run Text="{Binding Summary.ProcessorCount, Mode=OneWay}"/>
                                    <LineBreak/>
                                    <Run Text="Memory" Foreground="{StaticResource SubtleTextBrush}"/> <Run Text="{Binding Item.MemoryText, Mode=OneWay}"/>
                                    <LineBreak/>
                                    <Run Text="Switch" Foreground="{StaticResource SubtleTextBrush}"/> <Run Text="{Binding Item.SwitchText, Mode=OneWay}"/>
                                    <LineBreak/>
                                    <Run Text="Exposure" Foreground="{StaticResource SubtleTextBrush}"/>
                                    <Run Text="{Binding Item.ExposureText, Mode=OneWay}"
                                         Foreground="{Binding Item.Exposure, Mode=OneWay, Converter={StaticResource Exposure}, ConverterParameter=Brush}"/>
                                    <LineBreak/>
                                    <Run Text="IP" Foreground="{StaticResource SubtleTextBrush}"/> <Run Text="{Binding Item.IpText, Mode=OneWay}"/>
                                    <LineBreak/>
                                    <Run Text="Guest OS" Foreground="{StaticResource SubtleTextBrush}"/> <Run Text="{Binding Summary.GuestOperatingSystem, Mode=OneWay}"/>
                                    <LineBreak/>
                                    <Run Text="Checkpoints" Foreground="{StaticResource SubtleTextBrush}"/> <Run Text="{Binding Summary.CheckpointCount, Mode=OneWay}"/>
                                </TextBlock>

                                <TextBlock Style="{StaticResource SectionHeader}" Text="LOCATION"/>
                                <TextBox Text="{Binding Summary.ConfigurationPath, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"/>
                                <TextBox Text="{Binding Summary.Id, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Consolas"
                                         Foreground="{StaticResource SubtleTextBrush}"/>

                                <TextBlock Style="{StaticResource SectionHeader}" Text="HISTORY"/>
                                <ItemsControl ItemsSource="{Binding DataContext.SelectedVmHistory, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:AuditEntryView}">
                                            <DockPanel Margin="0,0,0,4" ToolTip="{Binding User}">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding When}" Width="108"
                                                           Foreground="{StaticResource SubtleTextBrush}" FontSize="12"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12"/>
                                                    <TextBlock Text="{Binding Error, StringFormat='Failed: {0}'}" TextWrapping="Wrap" FontSize="12"
                                                               Foreground="#E5534B" Visibility="{Binding Error, Converter={StaticResource NullToVis}}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No recorded actions yet." Foreground="{StaticResource SubtleTextBrush}" FontSize="12"
                                           Visibility="{Binding DataContext.SelectedVmHistory.Count, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CountToVis}, ConverterParameter=Inverse}"/>
                                <ui:Button Content="Open activity log" Icon="{ui:SymbolIcon History24}" Appearance="Transparent"
                                           Padding="6,4" Margin="-6,4,0,0" Click="OpenActivityLog_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <DockPanel Grid.Row="3" Margin="14,6,14,8">
            <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource SubtleTextBrush}" FontSize="11">
                <Run Text="Metadata:"/> <Run Text="{Binding MetadataFilePath, Mode=OneWay}"/>
            </TextBlock>
            <ui:Button DockPanel.Dock="Left" Content="Cancel" Padding="10,1" Margin="0,0,10,0" FontSize="11"
                       ToolTip="Stop the archive. VMs already exported stay in it; the one in progress is removed."
                       Command="{Binding CancelArchiveCommand}"
                       Visibility="{Binding IsArchiving, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11"
                       VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</ui:FluentWindow>

<ui:FluentWindow x:Class="VMCreate.Manager.DeletePreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="900" Height="560" MinWidth="600" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <DockPanel>
        <ui:TitleBar x:Name="DialogTitleBar" DockPanel.Dock="Top" ShowMinimize="False" ShowMaximize="False"/>

        <StackPanel DockPanel.Dock="Top" Margin="20,4,20,10">
            <Border x:Name="BlockerPanel" Background="#33E5534B" CornerRadius="4" Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="This VM cannot be deleted now:" FontWeight="SemiBold"/>
                    <TextBlock x:Name="BlockerText" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="20,10,20,20">
            <TextBlock x:Name="FoldersText" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,10"/>
            <StackPanel x:Name="ConfirmPanel">
                <CheckBox x:Name="PermanentBox" Content="Delete permanently (skip the Recycle Bin)" Checked="Permanent_Changed" Unchecked="Permanent_Changed"/>
                <TextBlock x:Name="RecycleNote" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Margin="28,2,0,10" TextWrapping="Wrap"
                           Text="Files go to the Recycle Bin. Windows asks before destroying a file that is too big for it."/>
                <TextBlock x:Name="TypeNamePrompt" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <ui:TextBox x:Name="NameBox" TextChanged="NameBox_TextChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button x:Name="DeleteButton" Content="Delete" Appearance="Danger" MinWidth="90" IsEnabled="False"
                           Icon="{ui:SymbolIcon Delete24}" Click="Delete_Click" Margin="0,0,8,0"/>
                <ui:Button x:Name="CancelButton" Content="Cancel" MinWidth="90" IsCancel="True" IsDefault="True"/>
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="FilesGrid" Margin="20,0,20,0" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Action" Binding="{Binding ActionText}" Width="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding ActionBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Type" Binding="{Binding KindText}" Width="100"/>
                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="80"/>
                <DataGridTextColumn Header="File" Binding="{Binding Path}" Width="3*"/>
                <DataGridTextColumn Header="Why" Binding="{Binding Reason}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</ui:FluentWindow>

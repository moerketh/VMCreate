<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>VMCreate.Manager.Core</AssemblyName>
    <RootNamespace>VMCreate.Manager</RootNamespace>
    <!-- Split rule: no reference to VMCreate.Core. Anything borrowed from it
         goes through an interface owned by this project, so the Manager can
         move to its own repository with only VMCreate.Metadata as a package. -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VMCreate.Manager" />
    <InternalsVisibleTo Include="VMCreate.Manager.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageReference Include="System.Management" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VMCreate.Metadata\VMCreate.Metadata.csproj" />
  </ItemGroup>

</Project>
